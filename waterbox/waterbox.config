   "options": [
    "fast",
    "real"
   ],
   "default": "fast",
   "description": "setting.tape_loading.about"
  },
  {
   "name": "auto_load",
   "display": "setting.auto_load",
   "type": "bool",
   "default": true,
   "description": "setting.auto_load.about"
  },
  {
   "name": "tape_auto",
   "display": "setting.tape_auto",
   "type": "bool",
   "default": true,
   "description": "setting.tape_auto.about"
  },
  {
   "name": "issue2",
