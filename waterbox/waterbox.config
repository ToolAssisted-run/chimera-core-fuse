 },
 "settings": [
  {
   "name": "machine",
   "display": "Machine",
   "type": "enum",
   "options": [
    "16",
    "48",
    "48_ntsc",
    "128",
    "plus2",
    "plus2a",
    "plus3",
    "plus3e",
    "se",
    "2048",
    "2068",
    "ts2068",
    "pentagon",
    "pentagon512",
    "pentagon1024",
    "scorpion"
   ],
   "default": "48",
   "description": "Which computer this is. \"16\" and \"48\" are the first ZX Spectrums, \"48_ntsc\" the 48K for American televisions. \"128\", \"plus2\", \"plus2a\", \"plus3\" and \"plus3e\" are the 128K Spectrums; the +3 has a disc drive. \"2048\", \"2068\" and \"ts2068\" are the Timex computers, and \"se\" is the ZX Spectrum SE, which runs with free ROMs. \"pentagon\", \"pentagon512\", \"pentagon1024\" and \"scorpion\" are the Russian 128K-compatible computers with a TR-DOS disc interface. Each machine needs its own ROM files, which the Firmware page lists. A snapshot file says which machine it was taken on, and that machine is used whatever is chosen here. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "joystick_1",
   "display": "Joystick 1",
   "type": "enum",
   "options": [
    "none",
    "cursor",
    "kempston",
    "sinclair1",
    "sinclair2",
    "timex1",
    "timex2",
    "fuller"
   ],
   "default": "kempston",
   "description": "What the first joystick (the buttons P1 Up, Down, Left, Right and Fire) is plugged into. \"kempston\" is the Kempston interface, the one most games offer. \"sinclair1\" and \"sinclair2\" are the two sockets of the Interface 2 and of the +2 and +3, which press the keys 6 to 0 and 1 to 5. \"cursor\" presses 5, 6, 7, 8 and 0. \"timex1\" and \"timex2\" are the Timex computers' own sockets, and \"fuller\" the Fuller box. \"none\" leaves it unplugged. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "joystick_2",
   "display": "Joystick 2",
   "type": "enum",
   "options": [
    "none",
    "cursor",
    "kempston",
    "sinclair1",
    "sinclair2",
    "timex1",
    "timex2",
    "fuller"
   ],
   "default": "none",
   "description": "What the second joystick (the buttons P2 Up, Down, Left, Right and Fire) is plugged into. The choices are Joystick 1's. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "tape_loading",
   "display": "Tape Loading",
   "type": "enum",
   "options": [
    "fast",
    "real"
   ],
   "default": "fast",
   "description": "How a tape loads. \"fast\" loads a standard tape block at once instead of playing it, and runs a game's own loading routine without waiting for the tape, so a game is there in seconds. \"real\" plays the tape as a tape recorder would, with the stripes and the noise, taking the minutes it took. A few protected games load only with \"real\". It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "auto_load",
   "display": "Load Tapes and Discs Automatically",
   "type": "bool",
   "default": true,
   "description": "When on, a tape or a disc in the project is started for you when the machine is switched on, as if you had typed LOAD \"\" or chosen the Loader. When off, the machine starts in its BASIC with the tape or disc in, and you load it yourself. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "tape_auto",
   "display": "Start and Stop the Tape by Itself",
   "type": "bool",
   "default": true,
   "description": "When on, the tape recorder starts when a program begins to read the tape and stops when it has finished, so a game that loads its levels from tape needs nothing from you; the buttons Tape Play and Tape Stop still work, but the tape starts again as soon as a program reads it. When off, the tape moves only when you press Tape Play and stops only when you press Tape Stop, as a real tape recorder does. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "issue2",
   "display": "Issue 2 Keyboard",
   "type": "bool",
   "default": false,
   "description": "The first 48K Spectrums (issue 1 and 2 boards) read the keyboard a little differently from all later ones, and a few early games work only on them. Leave it off unless a game from 1982 or 1983 does not answer the keys. It is part of the machine, so a movie needs the same value."
  },
  {
   "name": "late_timings",
   "display": "Late Timings",
   "type": "bool",
   "default": false,
   "description": "Real Spectrums come in two kinds, whose picture timing differs by one processor cycle once they are warm. It matters only to programs that draw in the border or change colours in the middle of a line. It is part of the machine, so a movie needs the same value."
  }
 ],
