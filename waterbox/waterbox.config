 },
 "settings": [
  {
   "name": "machine",
   "display": "setting.machine",
   "type": "enum",
   "options": [
    "16",
    "48",
    "48_ntsc",
    "128",
    "plus2",
    "plus2a",
    "plus3",
    "plus3e",
    "se",
    "2048",
    "2068",
    "ts2068",
    "pentagon",
    "pentagon512",
    "pentagon1024",
    "scorpion"
   ],
   "default": "48",
   "description": "setting.machine.about"
  },
  {
   "name": "joystick_1",
   "display": "setting.joystick_1",
   "type": "enum",
   "options": [
    "none",
    "cursor",
    "kempston",
    "sinclair1",
    "sinclair2",
    "timex1",
    "timex2",
    "fuller"
   ],
   "default": "kempston",
   "description": "setting.joystick_1.about"
  },
  {
   "name": "joystick_2",
   "display": "setting.joystick_2",
   "type": "enum",
   "options": [
    "none",
    "cursor",
    "kempston",
