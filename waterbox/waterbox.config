   "Reset",
   "P1 Up",
   "P1 Down",
   "P1 Left",
   "P1 Right",
   "P1 Fire",
   "P2 Up",
   "P2 Down",
   "P2 Left",
   "P2 Right",
   "P2 Fire"
  ],
  "mnemonics": {
