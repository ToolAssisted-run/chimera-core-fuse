   "type": "bool",
   "default": false,
   "description": "setting.issue2.about"
  },
  {
   "name": "late_timings",
   "display": "setting.late_timings",
   "type": "bool",
   "default": false,
   "description": "setting.late_timings.about"
  }
 ],
